# ===================================================
# DEV KRAFTERS — Environment Configuration Template
# Duplicate this file to .env.local and fill in your secrets.
# NEVER commit .env or .env.local with real credentials!
# ===================================================

# ── Database (MongoDB Atlas) ──────────────────────
# Format: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/Dev_Krafters?retryWrites=true&w=majority"
MONGODB_DB="Dev_Krafters"

# ── Admin Security & 2FA ──────────────────────────
# Secret PIN for admin dashboard fallback access
ADMIN_PASSCODE="your-secure-admin-passcode-here"

# Base32 secret for Google Authenticator TOTP (Optional, generates fallback if omitted)
ADMIN_TOTP_SECRET="JBSWY3DPEHPK3PXP"

# Secret key used to sign Admin session tokens (HMAC-SHA256)
ADMIN_SESSION_SECRET="generate-a-strong-random-session-secret-here"

# ── Email Service (Resend) ────────────────────────
# Get your API key at https://resend.com
RESEND_API_KEY="re_your_resend_api_key_here"

# Email address that receives contact form inquiries and lead notifications
CONTACT_RECEIVER_EMAIL="hello@devkrafters.com"

# ── AI Integration (Google Gemini) ────────────────
# Get your API key at https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# ── Public App URL ────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://devkrafters.com"
