generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id                     String   @id @default(uuid())
  type                   String   // 'contact' | 'newsletter' | 'estimate'
  name                   String?
  email                  String
  phone                  String?
  projectType            String?
  pages                  Int?
  budget                 String?
  totalEstimateFormatted String?
  totalEstimateInr       Int?
  message                String?
  date                   DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}
